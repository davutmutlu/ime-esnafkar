@model IEnumerable<EsnafKar.Models.GiderKategorisi>

@{
    ViewData["Title"] = "Gider Kategorileri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gider Kategorileri</h1>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kategori Ekle</a>
</div>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<p class="text-muted">Ortak kategoriler herkes için aynıdır ve değiştirilemez. Kendi kategorilerinizi ekleyip düzenleyebilirsiniz.</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Kategori Adı</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var kategori in Model)
        {
            <tr>
                <td>@kategori.Ad</td>
                <td class="text-end">
                    @if (kategori.KullaniciId == null)
                    {
                        <span class="badge bg-secondary">Ortak</span>
                    }
                    else
                    {
                        <a asp-action="Edit" asp-route-id="@kategori.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@kategori.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>