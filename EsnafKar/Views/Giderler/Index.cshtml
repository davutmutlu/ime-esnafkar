@model IEnumerable<EsnafKar.Models.Gider>

@{
    ViewData["Title"] = "Giderler";
    var aylar = new[] { "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
                        "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
    var seciliYil = ViewData["SeciliYil"] as int?;
    var seciliAy = ViewData["SeciliAy"] as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-receipt" style="color: #dc3545;"></i> Giderler</h1>
    <a asp-action="Create" class="btn btn-danger">+ Yeni Gider Ekle</a>
</div>

<form asp-action="Index" method="get" autocomplete="off" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label small">İşletme</label>
        <select name="isletmeId" asp-items="ViewBag.IsletmeId" class="form-select">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">Kategori</label>
        <select name="kategoriId" asp-items="ViewBag.GiderKategorisiId" class="form-select">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">Ay</label>
        <select name="ay" class="form-select">
            <option value="">Tümü</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" selected="@(i == seciliAy)">@aylar[i - 1]</option>
            }
        </select>
    </div>
    <div class="col-md-1">
        <label class="form-label small">Yıl</label>
        <input type="number" name="yil" value="@seciliYil" class="form-control" placeholder="Tümü" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel"></i> Filtrele</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Kayıt bulunamadı.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>İşletme</th>
                <th>Kategori</th>
                <th>Açıklama</th>
                <th class="text-end">Tutar</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gider in Model)
            {
                <tr>
                    <td>@gider.Tarih.ToString("dd.MM.yyyy")</td>
                    <td>@gider.Isletme?.Ad</td>
                    <td><i class="bi @EsnafKar.Models.KategoriSimgeleri.Getir(gider.GiderKategorisi?.Ad)" style="color: #fd7e14;"></i> @gider.GiderKategorisi?.Ad</td>
                    <td>@gider.Aciklama</td>
                    <td class="text-end">@gider.Tutar.ToString("N2") ₺</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@gider.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@gider.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="4">Toplam (@Model.Count() kayıt)</td>
                <td class="text-end">@Model.Sum(g => g.Tutar).ToString("N2") ₺</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
}