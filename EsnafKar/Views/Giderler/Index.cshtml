@model IEnumerable<EsnafKar.Models.Gider>

@{
    ViewData["Title"] = "Giderler";
}

<h1>Giderler</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Gider Ekle</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz kayıtlı bir gider yok.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Tarih)</th>
                <th>@Html.DisplayNameFor(model => model.IsletmeId)</th>
                <th>@Html.DisplayNameFor(model => model.GiderKategorisiId)</th>
                <th>@Html.DisplayNameFor(model => model.Aciklama)</th>
                <th class="text-end">@Html.DisplayNameFor(model => model.Tutar)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Tarih.ToString("dd.MM.yyyy")</td>
                    <td>@item.Isletme?.Ad</td>
                    <td><i class="bi @EsnafKar.Models.KategoriSimgeleri.Getir(item.GiderKategorisi?.Ad)" style="color: #fd7e14;"></i> @item.GiderKategorisi?.Ad</td>                    <td>@item.Aciklama</td>
                    <td class="text-end">@item.Tutar.ToString("N2") ₺</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="4">Toplam</td>
                <td class="text-end">@Model.Sum(g => g.Tutar).ToString("N2") ₺</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
}