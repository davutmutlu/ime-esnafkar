@model EsnafKar.Models.Gider

@{
    ViewData["Title"] = "Gideri Düzenle";
}

<h1>Gideri Düzenle</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="IsletmeId" class="form-label"></label>
                <select asp-for="IsletmeId" asp-items="ViewBag.IsletmeId" class="form-select">
                    <option value="">-- İşletme seçin --</option>
                </select>
                <span asp-validation-for="IsletmeId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GiderKategorisiId" class="form-label"></label>
                <select asp-for="GiderKategorisiId" asp-items="ViewBag.GiderKategorisiId" class="form-select">
                    <option value="">-- Kategori seçin --</option>
                </select>
                <span asp-validation-for="GiderKategorisiId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tutar" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Tutar" class="form-control" />
                    <span class="input-group-text">₺</span>
                </div>
                <div class="form-text">Kuruş için virgül kullanın, örn: 1500,50</div>
                <span asp-validation-for="Tutar" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tarih" class="form-label"></label>
                <input asp-for="Tarih" class="form-control" />
                <span asp-validation-for="Tarih" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label"></label>
                <input asp-for="Aciklama" class="form-control" />
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}