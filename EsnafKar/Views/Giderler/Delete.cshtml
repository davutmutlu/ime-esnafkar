@model EsnafKar.Models.Gider

@{
    ViewData["Title"] = "Gideri Sil";
}

<h1>Gideri Sil</h1>
<hr />

<div class="alert alert-danger">
    Bu gideri silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tarih)</dt>
    <dd class="col-sm-9">@Model.Tarih.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsletmeId)</dt>
    <dd class="col-sm-9">@Model.Isletme?.Ad</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.GiderKategorisiId)</dt>
    <dd class="col-sm-9">@Model.GiderKategorisi?.Ad</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tutar)</dt>
    <dd class="col-sm-9">@Model.Tutar.ToString("N2") ₺</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Aciklama)</dt>
    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Aciklama) ? "-" : Model.Aciklama)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>