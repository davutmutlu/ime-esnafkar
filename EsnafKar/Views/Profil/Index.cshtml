@model EsnafKar.Models.ProfilBilgisi

@{
    ViewData["Title"] = "Profilim";
}

<h1 class="mb-4"><i class="bi bi-person-circle" style="color: #0d6efd;"></i> Profilim</h1>

@if (TempData["Bilgi"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Bilgi"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Sol: hesap özeti -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-person-circle" style="font-size: 5rem; color: #0d6efd;"></i>
                <h5 class="mt-2 mb-1">@Model.Eposta</h5>
                <p class="text-muted small">EsnafKar hesabı</p>

                <div class="row text-center mt-4">
                    <div class="col-4">
                        <div class="fs-3 fw-bold" style="color: #0d6efd;">@Model.IsletmeSayisi</div>
                        <div class="small text-muted"><i class="bi bi-shop"></i> İşletme</div>
                    </div>
                    <div class="col-4">
                        <div class="fs-3 fw-bold" style="color: #198754;">@Model.GelirKaydi</div>
                        <div class="small text-muted"><i class="bi bi-cash-coin"></i> Gelir kaydı</div>
                    </div>
                    <div class="col-4">
                        <div class="fs-3 fw-bold" style="color: #dc3545;">@Model.GiderKaydi</div>
                        <div class="small text-muted"><i class="bi bi-receipt"></i> Gider kaydı</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ: şifre değiştirme -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="card-title mb-3"><i class="bi bi-key" style="color: #fd7e14;"></i> Şifre Değiştir</h5>

                <form asp-action="SifreDegistir" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Sifre.MevcutSifre" class="form-label"></label>
                        <input asp-for="Sifre.MevcutSifre" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Sifre.MevcutSifre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre.YeniSifre" class="form-label"></label>
                        <input asp-for="Sifre.YeniSifre" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Sifre.YeniSifre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre.YeniSifreTekrar" class="form-label"></label>
                        <input asp-for="Sifre.YeniSifreTekrar" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Sifre.YeniSifreTekrar" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Şifreyi Değiştir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
