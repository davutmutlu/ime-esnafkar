@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center py-4">
    <h1 class="display-5 fw-bold">EsnafKar</h1>
    <p class="lead">Gelirinizi ve giderinizi girin, ayın sonunda ne kadar kazandığınızı görün.</p>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">İşletmeler</h5>
                <p class="card-text">İşletmenizi ve türünü kaydedin.</p>
                <a asp-controller="Isletmeler" asp-action="Index" class="btn btn-outline-primary mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Gelirler</h5>
                <p class="card-text">Her günün cirosunu girin.</p>
                <a asp-controller="Gelirler" asp-action="Index" class="btn btn-outline-primary mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Giderler</h5>
                <p class="card-text">Kira, fatura, maaş gibi masraflarınızı girin.</p>
                <a asp-controller="Giderler" asp-action="Index" class="btn btn-outline-primary mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-primary">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Kâr Raporu</h5>
                <p class="card-text">Aylık gelirinizi, giderinizi ve net kârınızı görün.</p>
                <a asp-controller="KarRaporu" asp-action="Index" class="btn btn-primary mt-auto align-self-start">Raporu Gör</a>
            </div>
        </div>
    </div>
</div>