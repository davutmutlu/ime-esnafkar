@model EsnafKar.Models.GostergePaneli

@{
    ViewData["Title"] = "Ana Sayfa";
    var aylar = new[] { "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
                        "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
    var buAy = aylar[DateTime.Today.Month - 1] + " " + DateTime.Today.Year;
}

<div class="text-center py-4">
    <h1 class="display-5 fw-bold"><i class="bi bi-shop-window text-primary"></i> EsnafKar</h1>
    <p class="lead">Gelirinizi ve giderinizi girin, ayın sonunda ne kadar kazandığınızı görün.</p>
</div>

@if (Model != null)
{
    <h4 class="mb-3"><i class="bi bi-speedometer2"></i> @buAy Özeti</h4>

    @if (Model.IsletmeSayisi == 0)
    {
        <div class="alert alert-warning">
            Henüz bir işletmeniz yok. Başlamak için
            <a asp-controller="Isletmeler" asp-action="Create" class="alert-link">ilk işletmenizi ekleyin</a>.
        </div>
    }
    else
    {
        <div class="row g-3 mb-5">
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted"><i class="bi bi-shop" style="color: #0d6efd;"></i> İşletme</div>
                        <div class="fs-3 fw-bold">@Model.IsletmeSayisi</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted"><i class="bi bi-arrow-up-circle" style="color: #198754;"></i> Bu Ay Gelir</div>
                        <div class="fs-3 fw-bold" style="color: #198754;">@Model.BuAyGelir.ToString("N2") ₺</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted"><i class="bi bi-arrow-down-circle" style="color: #dc3545;"></i> Bu Ay Gider</div>
                        <div class="fs-3 fw-bold" style="color: #dc3545;">@Model.BuAyGider.ToString("N2") ₺</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted"><i class="bi bi-piggy-bank" style="color: #6f42c1;"></i> @(Model.BuAyNetKar >= 0 ? "Bu Ay Net Kâr" : "Bu Ay Zarar")</div>
                        <div class="fs-3 fw-bold" style="color: @(Model.BuAyNetKar >= 0 ? "#6f42c1" : "#fd7e14");">@Model.BuAyNetKar.ToString("N2") ₺</div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #0d6efd;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-shop fs-1 mb-2" style="color: #0d6efd;"></i>
                <h5 class="card-title">İşletmeler</h5>
                <p class="card-text">İşletmenizi ve türünü kaydedin.</p>
                <a asp-controller="Isletmeler" asp-action="Index" class="btn btn-outline-primary mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #198754;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-cash-coin fs-1 mb-2" style="color: #198754;"></i>
                <h5 class="card-title">Gelirler</h5>
                <p class="card-text">Her günün cirosunu girin.</p>
                <a asp-controller="Gelirler" asp-action="Index" class="btn btn-outline-success mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #dc3545;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-receipt fs-1 mb-2" style="color: #dc3545;"></i>
                <h5 class="card-title">Giderler</h5>
                <p class="card-text">Kira, fatura, maaş gibi masraflarınızı girin.</p>
                <a asp-controller="Giderler" asp-action="Index" class="btn btn-outline-danger mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #6f42c1;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-graph-up-arrow fs-1 mb-2" style="color: #6f42c1;"></i>
                <h5 class="card-title">Kâr Raporu</h5>
                <p class="card-text">Aylık gelirinizi, giderinizi ve net kârınızı görün.</p>
                <a asp-controller="KarRaporu" asp-action="Index" class="btn text-white mt-auto align-self-start" style="background-color: #6f42c1;">Raporu Gör</a>
            </div>
        </div>
    </div>
</div>