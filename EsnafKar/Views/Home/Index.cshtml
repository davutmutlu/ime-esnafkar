@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center py-4">
    <h1 class="display-5 fw-bold"><i class="bi bi-shop-window text-primary"></i> EsnafKar</h1>
    <p class="lead">Gelirinizi ve giderinizi girin, ayın sonunda ne kadar kazandığınızı görün.</p>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #0d6efd;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-shop fs-1 mb-2" style="color: #0d6efd;"></i>
                <h5 class="card-title">İşletmeler</h5>
                <p class="card-text">İşletmenizi ve türünü kaydedin.</p>
                <a asp-controller="Isletmeler" asp-action="Index" class="btn btn-outline-primary mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #198754;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-cash-coin fs-1 mb-2" style="color: #198754;"></i>
                <h5 class="card-title">Gelirler</h5>
                <p class="card-text">Her günün cirosunu girin.</p>
                <a asp-controller="Gelirler" asp-action="Index" class="btn btn-outline-success mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #dc3545;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-receipt fs-1 mb-2" style="color: #dc3545;"></i>
                <h5 class="card-title">Giderler</h5>
                <p class="card-text">Kira, fatura, maaş gibi masraflarınızı girin.</p>
                <a asp-controller="Giderler" asp-action="Index" class="btn btn-outline-danger mt-auto align-self-start">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100" style="border-top: 4px solid #6f42c1;">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-graph-up-arrow fs-1 mb-2" style="color: #6f42c1;"></i>
                <h5 class="card-title">Kâr Raporu</h5>
                <p class="card-text">Aylık gelirinizi, giderinizi ve net kârınızı görün.</p>
                <a asp-controller="KarRaporu" asp-action="Index" class="btn text-white mt-auto align-self-start" style="background-color: #6f42c1;">Raporu Gör</a>
            </div>
        </div>
    </div>
</div>