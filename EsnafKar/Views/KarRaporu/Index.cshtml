@model EsnafKar.Models.KarRaporu

@{
    ViewData["Title"] = "Aylık Kâr Raporu";
    var aylar = new[] { "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
                        "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
}

@functions {
    string DegisimMetni(decimal? yuzde)
    {
        if (yuzde == null) return "Geçen ay veri yok";
        if (yuzde == 0) return "Geçen ayla aynı";
        return $"Geçen aya göre %{Math.Abs(yuzde.Value):N1} {(yuzde > 0 ? "arttı" : "azaldı")}";
    }

    string DegisimSimgesi(decimal? yuzde)
    {
        if (yuzde == null || yuzde == 0) return "bi-dash";
        return yuzde > 0 ? "bi-caret-up-fill" : "bi-caret-down-fill";
    }
}

<h1>Aylık Kâr Raporu</h1>
<hr />

<form asp-action="Index" method="get" autocomplete="off" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label">İşletme</label>
        <select name="isletmeId" asp-items="ViewBag.IsletmeId" class="form-select">
            <option value="">-- İşletme seçin --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Ay</label>
        <select name="ay" class="form-select">
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" selected="@(i == Model.Ay)">@aylar[i - 1]</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Yıl</label>
        <input type="number" name="yil" value="@Model.Yil" class="form-control" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Göster</button>
    </div>
</form>

@if (Model.IsletmeId == null)
{
    <div class="alert alert-info">Raporu görmek için bir işletme seçip Göster'e basın.</div>
}
else
{
    var gelirDegisim = EsnafKar.Models.KarRaporu.Degisim(Model.ToplamGelir, Model.OncekiGelir);
    var giderDegisim = EsnafKar.Models.KarRaporu.Degisim(Model.ToplamGider, Model.OncekiGider);
    var karDegisim = EsnafKar.Models.KarRaporu.Degisim(Model.NetKar, Model.OncekiNetKar);

    <h4 class="mb-3">@aylar[Model.Ay - 1] @Model.Yil</h4>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-bg-success h-100">
                <div class="card-body">
                    <div><i class="bi bi-arrow-up-circle"></i> Toplam Gelir</div>
                    <div class="fs-3 fw-bold">@Model.ToplamGelir.ToString("N2") ₺</div>
                    <div class="small"><i class="bi @DegisimSimgesi(gelirDegisim)"></i> @DegisimMetni(gelirDegisim)</div>
                    <div class="small opacity-75">Geçen ay: @Model.OncekiGelir.ToString("N2") ₺</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-danger h-100">
                <div class="card-body">
                    <div><i class="bi bi-arrow-down-circle"></i> Toplam Gider</div>
                    <div class="fs-3 fw-bold">@Model.ToplamGider.ToString("N2") ₺</div>
                    <div class="small"><i class="bi @DegisimSimgesi(giderDegisim)"></i> @DegisimMetni(giderDegisim)</div>
                    <div class="small opacity-75">Geçen ay: @Model.OncekiGider.ToString("N2") ₺</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card @(Model.NetKar >= 0 ? "text-bg-primary" : "text-bg-warning") h-100">
                <div class="card-body">
                    <div><i class="bi bi-piggy-bank"></i> @(Model.NetKar >= 0 ? "Net Kâr" : "Zarar")</div>
                    <div class="fs-3 fw-bold">@Model.NetKar.ToString("N2") ₺</div>
                    <div class="small"><i class="bi @DegisimSimgesi(karDegisim)"></i> @DegisimMetni(karDegisim)</div>
                    <div class="small opacity-75">Geçen ay: @Model.OncekiNetKar.ToString("N2") ₺</div>
                </div>
            </div>
        </div>
    </div>

    <h5>Gider Dağılımı</h5>
    @if (!Model.GiderDagilimi.Any())
    {
        <div class="alert alert-secondary">Bu ay için gider girilmemiş.</div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th class="text-end">Tutar</th>
                    <th class="text-end">Oran</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.GiderDagilimi)
                {
                    <tr>
                        <td><i class="bi @EsnafKar.Models.KategoriSimgeleri.Getir(k.Kategori)" style="color: #fd7e14;"></i> @k.Kategori</td>
                        <td class="text-end">@k.Tutar.ToString("N2") ₺</td>
                        <td class="text-end">%@((k.Tutar / Model.ToplamGider * 100).ToString("N1"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}