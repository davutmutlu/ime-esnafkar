@model EsnafKar.Models.Isletme

@{
    ViewData["Title"] = "İşletmeyi Sil";
}

<h1>İşletmeyi Sil</h1>
<hr />

<div class="alert alert-danger">
    <strong>@Model.Ad</strong> adlı işletmeyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Ad)</dt>
    <dd class="col-sm-9">@Model.Ad</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tur)</dt>
    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Tur) ? "Belirtilmemiş" : Model.Tur)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OlusturmaTarihi)</dt>
    <dd class="col-sm-9">@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>