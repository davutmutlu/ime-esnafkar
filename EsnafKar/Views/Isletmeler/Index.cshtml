@model IEnumerable<EsnafKar.Models.Isletme>

@{
    ViewData["Title"] = "İşletmeler";
}

<h1>İşletmeler</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Yeni İşletme Ekle</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Henüz kayıtlı bir işletme yok. Başlamak için yeni bir işletme ekleyin.
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Ad)</th>
                <th>@Html.DisplayNameFor(model => model.Tur)</th>
                <th>@Html.DisplayNameFor(model => model.OlusturmaTarihi)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Ad</td>
                    <td>@item.Tur</td>
                    <td>@item.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}